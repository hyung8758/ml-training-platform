# 공식 ClearML Server Compose가 참조할 Server의 접근 가능한 IP 또는 DNS 이름이다.
CLEARML_HOST_IP="<CLEARML_SERVER_IP_OR_HOSTNAME>"

# A의 공식 Compose 내부 agent-services 전용 난수 credential이다.
# B/C 학습 Agent가 사용하는 CLEARML_API_ACCESS_KEY/SECRET_KEY와 다른 값이다.
CLEARML_AGENT_ACCESS_KEY="<GENERATE_SERVER_SERVICE_ACCESS_KEY>"
CLEARML_AGENT_SECRET_KEY="<GENERATE_SERVER_SERVICE_SECRET_KEY>"

# Private Git 접근이 필요하면 host secret 관리 방식으로 설정하고 Git에는 넣지 않는다.
# CLEARML_AGENT_GIT_USER="<GIT_USER>"
# CLEARML_AGENT_GIT_PASS="<GIT_TOKEN_OR_PASSWORD>"
