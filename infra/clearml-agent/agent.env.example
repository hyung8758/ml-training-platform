# Worker별 실제 값으로 복사해 agent.env로 저장하며 agent.env는 commit하지 않는다.
CLEARML_API_HOST="http://<CLEARML_SERVER_IP>:8008"
CLEARML_WEB_HOST="http://<CLEARML_SERVER_IP>:8080"
CLEARML_FILES_HOST="http://<CLEARML_SERVER_IP>:8081"
CLEARML_API_ACCESS_KEY="<CLEARML_API_ACCESS_KEY>"
CLEARML_API_SECRET_KEY="<CLEARML_API_SECRET_KEY>"
CLEARML_QUEUE="<CLEARML_QUEUE_NAME>"
CLEARML_AGENT_GPU=all
ML_DATA_ROOT=/mnt/ml-data
ML_RESULT_ROOT=/mnt/ml-results

# 필요할 때만 Worker 고유 식별자를 지정한다.
# CLEARML_WORKER_ID="<WORKER_NAME>"
